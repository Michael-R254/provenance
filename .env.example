# Copy to .env for local development. Never commit real values.

# API (apps/api)
PROVENANCE_ENVIRONMENT=development
PROVENANCE_ALLOWED_ORIGINS=["http://localhost:3000"]
PROVENANCE_DATABASE_URL=postgresql://provenance:provenance-local-only@localhost:5432/provenance
# Throwaway database for integration tests (its schema is wiped on every test)
PROVENANCE_TEST_DATABASE_URL=postgresql://provenance:provenance-local-only@localhost:5432/provenance_test

# Model provider: mock (default, free), ollama (free, local) or anthropic (paid; production only)
PROVENANCE_LLM_PROVIDER=mock
# PROVENANCE_ANTHROPIC_API_KEY=
# PROVENANCE_OLLAMA_URL=http://localhost:11434
# PROVENANCE_OLLAMA_MODEL=llama3.2
# Signs visitor session tokens. Any long random string locally; a secret in production.
PROVENANCE_SESSION_SECRET=replace-with-a-long-random-string-for-local-use
# Cloudflare's always-pass test secret is the default; production needs the real one.
# PROVENANCE_TURNSTILE_SECRET=
# PROVENANCE_IP_HASH_SALT=
# Cost controls (see docs/architecture.md section 7)
PROVENANCE_DAILY_SPEND_CAP_USD=1.0
PROVENANCE_MAX_OUTPUT_TOKENS=600

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
